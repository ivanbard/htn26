# Copy to .env beside server.mjs. Values here are loaded automatically at startup.
# Keep .env private; never commit real credentials.
OPENAI_API_KEY=sk-replace-me
OPENAI_LAYOUT_TIMEOUT_MS=15000

# Laptop HTTP server
HTN26_BIND_HOST=127.0.0.1
HTN26_PORT=8787
HTN26_DATA_DIR=./data
HTN26_SERIAL_DEVICE=/dev/ttyACM0
HTN26_CORS_ORIGIN=http://127.0.0.1:4173
NODE_ENV=development

# Gameplay timing and capacity
HTN26_ROUND_SECONDS=240
HTN26_ORDER_INTERVAL_MIN_SECONDS=8
HTN26_ORDER_INTERVAL_MAX_SECONDS=35
HTN26_ORDER_PATIENCE_SECONDS=30
HTN26_MAX_ACTIVE_ORDERS=3
HTN26_PLAYER_LOCATION_HOLD_SECONDS=2

# Optional QNX difficulty sidecar; leave blank to use normal laptop fallback.
HTN26_DIFFICULTY_SIDECAR_URL=
HTN26_DIFFICULTY_SIDECAR_TIMEOUT_MS=200
